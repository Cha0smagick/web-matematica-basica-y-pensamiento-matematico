    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "stylelint": "^16.3.0",
